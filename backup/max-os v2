    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&amp;family=Source+Sans+3:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
    <style>
      :root {
        --neon-green: #9dff00;
        --glass-top: #369900;
        --glass-center: #ADFF2F;
        --glass-bottom: #e4ff00;
      }

      html, body, #root {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background-color: #050505;
        overflow: hidden;
        font-family: 'Source Sans 3', sans-serif;
        position: fixed;
        top: 0;
        left: 0;
      }

      /* Title Font */
      .font-orbitron {
        font-family: 'Orbitron', sans-serif !important;
      }

      /* Use system monospace for terminals */
      .font-mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
      }
      
      .scanlines {
        background: linear-gradient(
          to bottom,
          rgba(255,255,255,0),
          rgba(255,255,255,0) 50%,
          rgba(0,0,0,0.1) 50%,
          rgba(0,0,0,0.1)
        );
        background-size: 100% 4px;
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        opacity: 0.15;
      }

      /* --- Animations --- */
      
      /* CRT Turn On Animation */
      @keyframes crt-turn-on {
        0% {
          transform: scale(1, 0.01) translate3d(0, 0, 0);
          filter: brightness(30);
          opacity: 1;
        }
        50% {
            transform: scale(1, 0.05) translate3d(0, 0, 0);
             filter: brightness(5);
        }
        60% {
          transform: scale(1, 1) translate3d(0, 0, 0);
          filter: brightness(1.5);
          opacity: 1;
        }
        100% {
          transform: scale(1, 1) translate3d(0, 0, 0);
          filter: brightness(1);
          opacity: 1;
        }
      }

      .animate-crt-on {
        animation: crt-turn-on 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
      }
      
      /* CRT Turn Off Animation */
      @keyframes crt-turn-off {
        0% {
            transform: scale(1, 1);
            filter: brightness(1);
            opacity: 1;
        }
        40% {
            transform: scale(1, 0.01);
            filter: brightness(10);
        }
        100% {
            transform: scale(0, 0);
            opacity: 0;
        }
      }

      .animate-crt-off {
          animation: crt-turn-off 0.4s cubic-bezier(0.23, 1, 0.32, 1) forwards;
      }

      /* Stable Glitch (Voltage Drop Simulation) */
      @keyframes stable-glitch {
        0%, 45% { opacity: 1; filter: brightness(1); }
        46% { opacity: 0.6; filter: brightness(0.8); }
        47% { opacity: 1; filter: brightness(1.2); }
        48% { opacity: 1; filter: brightness(1); }
        
        80% { opacity: 1; filter: brightness(1); }
        81% { opacity: 0.2; filter: brightness(0.5); }
        82% { opacity: 1; filter: brightness(1.5); }
        83% { opacity: 1; filter: brightness(1); }
        
        95% { opacity: 1; filter: brightness(1); }
        96% { opacity: 0.7; filter: brightness(0.9); }
        97% { opacity: 1; filter: brightness(1); }
        100% { opacity: 1; filter: brightness(1); }
      }

      .animate-stable-glitch {
        animation: stable-glitch 4s infinite linear; 
      }

      /* WiFi Data Blink (Irregular) */
      @keyframes wifi-activity {
          0%, 100% { color: #444; text-shadow: none; }
          5%, 15% { color: #9dff00; text-shadow: 0 0 8px #9dff00; }
          30% { color: #444; text-shadow: none; }
          35%, 45% { color: #9dff00; text-shadow: 0 0 8px #9dff00; }
          70% { color: #444; text-shadow: none; }
          72%, 75% { color: #9dff00; text-shadow: 0 0 8px #9dff00; }
      }
      
      .animate-wifi-blink {
          animation: wifi-activity 2s infinite steps(1);
      }

      /* --- TEXTURES --- */
      
      .mesh-grill {
        background-image: 
          radial-gradient(#000 15%, transparent 16%),
          radial-gradient(#000 15%, transparent 16%);
        background-size: 4px 4px;
        background-position: 0 0, 2px 2px;
        background-color: #333;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
      }
      
      .machined-grip {
        background: repeating-linear-gradient(
          90deg,
          #444,
          #444 1px,
          #222 1px,
          #222 3px
        );
        box-shadow: inset 0 0 5px rgba(0,0,0,0.8);
      }

      .hazard-stripe {
        background: repeating-linear-gradient(
          45deg,
          #1a1a1a,
          #1a1a1a 5px,
          #2a2a2a 5px,
          #2a2a2a 10px
        );
      }

      /* --- CHROME SHELL (Adjusted Gradient) --- */
      .metal-horizontal {
        background: linear-gradient(
          180deg, 
          #7a7a7a 0%,      
          #ffffff 12%,     
          #ffffff 22%,     
          #bfbfbf 28%,     
          #3a3a3a 32%,     
          #3a3a3a 42%,     
          #888888 55%,     
          #dcdcdc 70%,     
          #999999 82%,    
          #444444 92%,    
          #ffffff 96%,     
          #ffffff 100%
        );
        border-top: 1px solid #fff;
        border-bottom: 1px solid #444; 
        border-left: 1px solid #888;
        border-right: 1px solid #888;
        position: relative;
        box-shadow: 0 10px 30px rgba(0,0,0,0.8);
      }
      
      .metal-horizontal::before {
        content: ''; position: absolute; inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
        pointer-events: none; mix-blend-mode: multiply;
      }

      .metal-vertical {
        background: linear-gradient(
          90deg, 
          #7a7a7a 0%,      
          #ffffff 12%,     
          #ffffff 22%,     
          #bfbfbf 28%,     
          #3a3a3a 32%,     
          #3a3a3a 42%,     
          #888888 55%,     
          #dcdcdc 70%,     
          #999999 82%,    
          #444444 92%,    
          #ffffff 96%,     
          #ffffff 100%
        );
      }

      /* --- SIMPLE METAL --- */
      .metal-simple-horizontal {
        background: linear-gradient(
          180deg, 
          #ffffff 0%, #d0d0d0 20%, #a0a0a0 45%, #505050 50%, #909090 51%, #e0e0e0 85%, #b0b0b0 100%      
        );
        border-top: 1px solid #fff;
        border-bottom: 1px solid #222;
        border-left: 1px solid #666;
        border-right: 1px solid #666;
        position: relative;
      }

      .metal-simple-vertical {
        background: linear-gradient(
          90deg, 
          #ffffff 0%, #d0d0d0 20%, #a0a0a0 45%, #505050 50%, #909090 51%, #e0e0e0 85%, #b0b0b0 100%      
        );
        border-top: 1px solid #666;
        border-bottom: 1px solid #666;
      }

      /* --- 屏幕玻璃高光层 --- */
      .screen-glass-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 50; /* Ensure high z-index to overlay buttons */
        background: linear-gradient(
          125deg, 
          rgba(255,255,255,0.15) 0%, 
          rgba(255,255,255,0.05) 30%, 
          rgba(255,255,255,0.0) 45%, 
          rgba(255,255,255,0.02) 60%,
          rgba(255,255,255,0.1) 100%
        );
        box-shadow: inset 0 0 30px rgba(0,0,0,0.8);
        mix-blend-mode: overlay;
      }

      .engraved-icon {
        color: #000000; 
        filter: drop-shadow(0 1.5px 0.5px rgba(255,255,255,0.8)); 
        opacity: 1;
      }
      
      .engraved-text {
        color: #000000;
        text-shadow: 0 1.5px 0.5px rgba(255,255,255,0.8); 
        font-weight: 800;
        letter-spacing: 0.12em;
      }

      .metal-recess {
        background: linear-gradient(180deg, #999999 0%, #bbbbbb 100%); 
        border-radius: 999px;
        box-shadow: 
           inset 0 4px 10px rgba(0,0,0,0.6),    
           0 1.5px 0px rgba(255,255,255,1);      
        border: 1px solid #777;                
      }

      .socket-frame {
        background: linear-gradient(180deg, #888888 0%, #aaaaaa 100%); 
        border-radius: 999px;
        box-shadow: 0 1.5px 0px rgba(255,255,255,1);      
        border: 1px solid #666;
        padding: 4px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .socket-frame.rect {
          border-radius: 6px;
      }

      .socket-frame.round-xl {
          border-radius: 12px;
      }
      
      .led-socket {
        background: #111;
        box-shadow: 
            inset 0 2px 4px rgba(0,0,0,0.9),
            inset 0 -1px 1px rgba(255,255,255,0.2),
            0 1px 0 rgba(255,255,255,0.8);
        border: 1px solid #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2px;
      }

      .display-recess {
        background: linear-gradient(180deg, #010101 0%, #0c0c0c 100%); 
        border-radius: 999px; 
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
        box-shadow: inset 0 6px 15px rgba(0,0,0,1);    
        border: 1px solid #000;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .display-recess.rect {
          border-radius: 4px;
      }
      
      .display-recess::after {
        content: ''; 
        position: absolute; 
        top: 2px; left: 5px; right: 5px; height: 42%; 
        border-radius: inherit;
        background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0.1) 100%);
        filter: blur(1.5px); 
        opacity: 0.9; 
        pointer-events: none; 
        z-index: 10;
      }
      
      .bio-liquid {
        width: 100%; height: 100%; border-radius: 999px;
        position: relative; overflow: hidden;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(180deg, var(--glass-top) 0%, var(--glass-top) 40%, var(--glass-center) 85%, var(--glass-bottom) 100%);
        box-shadow: none; 
      }
      
      .bio-liquid::after {
        content: ''; position: absolute; top: 2px; left: 5px; right: 5px; height: 42%; 
        border-radius: 999px;
        background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(255,255,255,0.1) 100%);
        filter: blur(1.5px); opacity: 0.95; pointer-events: none; z-index: 10;
      }

      .chrome-btn {
        background: linear-gradient(
          180deg, #aaaaaa 0%, #ffffff 15%, #4a4a4a 35%, #4a4a4a 45%, #aaaaaa 65%, #ffffff 98%, #ffffff 100%
        );
        border: 1px solid #666; 
        box-shadow: inset 0 1px 0 rgba(255,255,255,1), 0 5px 12px rgba(0,0,0,0.7);            
        display: flex; align-items: center; justify-content: center;
      }
      .chrome-btn:active {
        background: linear-gradient(180deg, #666 0%, #999 100%);
        box-shadow: inset 0 6px 12px rgba(0,0,0,0.9);
        border-color: #444;
        transform: translateY(2px);
      }
      
      .chrome-relief-btn {
         background: linear-gradient(to bottom, #ffffff, #bbbbbb);
         border: 1px solid #777;
         box-shadow: inset 0 1px 0 white, 0 3px 6px rgba(0,0,0,0.6);
         border-radius: 4px;
         display: flex; align-items: center; justify-content: center;
      }

      .liquid-text { 
          font-family: 'Orbitron', sans-serif !important; 
          color: #0f2b00; 
          font-weight: 900; 
          letter-spacing: 0.18em;
          font-size: 1.2rem;
          position: relative; z-index: 20; 
      }

      .screen-bezel {
        box-shadow: inset 0 0 30px rgba(0,0,0,1), inset 0 0 5px rgba(255,255,255,0.4); 
        background: #000;
        border: 1px solid #333; 
        position: relative;
      }

      ::-webkit-scrollbar { width: 14px; }
      ::-webkit-scrollbar-track { background: #050505; border-left: 1px solid #333; }
      ::-webkit-scrollbar-thumb { 
        background: linear-gradient(90deg, #444, #999, #444); 
        border: 3px solid #000; 
        border-radius: 4px;
        box-shadow: inset 0 0 5px rgba(0,0,0,0.8);
      }
